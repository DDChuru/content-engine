
# rendered explainers are built artefacts (see packages/backend/output/mechanics)
public/videos/*.mp4

.env.local

# Convex generated client (regenerated by `convex dev` / `convex deploy`)
convex/_generated/

# The root .gitignore excludes lockfiles monorepo-wide. This app deploys to Vercel,
# which needs an authoritative lockfile for `npm ci` — without it every build
# re-resolves ~468 packages and ships something other than what was tested.
!package-lock.json
