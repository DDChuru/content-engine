# Copy to .env.local and fill in. Secrets are never committed.

# Convex
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Bunny Stream — the lesson videos.
# The pull-zone host is public (it is in every video URL) and MUST be set in the
# deploy environment: without it the player falls back to the host baked into
# lib/video.ts, which is a default, not a configuration.
NEXT_PUBLIC_BUNNY_CDN_HOST=vz-c77378c6-e3c.b-cdn.net
# Server-side only. Needed for uploading/managing videos, never for playback,
# and must never be exposed to the client.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=

# Analytics — Plausible (cookieless, no consent banner; see components/analytics.tsx)
# The site's domain exactly as registered in Plausible. UNSET = analytics is off,
# which is the correct default for local development.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Only for a self-hosted/Community-Edition install. Leave blank for the cloud.
NEXT_PUBLIC_PLAUSIBLE_HOST=
# Set to 1 to console.info every event instead of guessing whether it fired.
NEXT_PUBLIC_ANALYTICS_DEBUG=

# Error monitoring — Sentry (loaded lazily, only by a session that throws).
# UNSET = monitoring is off. Needs a project created by hand; see lib/monitoring.ts.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=
