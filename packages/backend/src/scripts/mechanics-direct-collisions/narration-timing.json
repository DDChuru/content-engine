    {
      "id": "s06",
      "title": "Trial 2: they stick together",
      "mode": "together",
      "tempo": "slow",
      "beats": [
        {
          "id": "reset",
          "text": "Reset to the original incoming particles. This independent trial ends with them sticking.",
          "start": 0.55,
          "speechEnd": 7.41,
          "end": 7.41,
          "hold": 0.0,
          "providerAudioSha256": "ad00c8232b0b5e0096d8b6e75974e846301ee2ef25d7c5ee44645fc1296b916d",
          "providerTrimStart": 0.0,
          "providerTrimEnd": 6.86
        },
        {
          "id": "principle",
          "text": "The same external force condition holds, so momentum before equals momentum after.",
          "start": 7.56,
          "speechEnd": 14.21,
          "end": 14.21,
          "hold": 0.0,
          "providerAudioSha256": "5e67c60d220e40f19540c006e9885e374a866b1f3432b6d1ad49ea3efecff9fe",
          "providerTrimStart": 0.03,
          "providerTrimEnd": 6.68,
          "cuePhrase": "momentum before",
          "ink": "momentum before = momentum after"
        },
        {
          "id": "formula",
          "text": "After sticking, both have velocity v. Mass A times u A, plus mass B times u B, equals the sum of the masses, times v.",
          "start": 14.36,
          "speechEnd": 27.42,
          "end": 27.42,
          "hold": 0.0,
          "providerAudioSha256": "19a63b0b8915d3cdd4c8e0d4791f7f842f4bbe03490436a6af6933387e379d5e",
          "providerTrimStart": 0.0,
          "providerTrimEnd": 13.06,
          "ink": "mA uA + mB uB = (mA + mB)v"
        },
        {
          "id": "substitute",
          "text": "Two times four, plus three times negative one, equals two plus three, all multiplied by v.",
          "start": 27.57,
          "speechEnd": 34.67,
          "end": 34.67,
          "hold": 0.0,
          "providerAudioSha256": "8554014389fb93bb284a86b8bbfc2ed58937772045f9d38f66c6a74df6597cef",
          "providerTrimStart": 0.05,
          "providerTrimEnd": 7.15,
          "figures": [
            {
              "phrase": "two",
              "target": "A.mass",
              "value": "2"
            },
            {
              "phrase": "four",
              "target": "A.before",
              "value": "4"
            },
            {
              "phrase": "three",
              "target": "B.mass",
              "value": "3"
            },
            {
              "phrase": "one",
              "target": "B.before",
              "value": "1"
            },
            {
              "phrase": "two",
              "occurrence": 2,
              "target": "A.mass",
