    {
      "id": "s02",
      "title": "Two alternative collision trials",
      "mode": "story",
      "tempo": "brisk",
      "beats": [
        {
          "id": "approach",
          "text": "Consider two particles moving towards each other along the same straight line on a smooth horizontal surface.",
          "start": 0.55,
          "speechEnd": 8.12,
          "end": 8.12,
          "hold": 0.0,
          "providerAudioSha256": "fe53272c7c6006841a619fd686a207c58a4a825aba6a84a708a9888b62558529",
          "providerTrimStart": 0.02,
          "providerTrimEnd": 7.59,
          "caption": "Same straight line"
        },
        {
          "id": "contact1",
          "text": "They meet. In the first trial, A rebounds and the particles separate.",
          "start": 8.27,
          "speechEnd": 13.9,
          "end": 13.9,
          "hold": 0.0,
          "providerAudioSha256": "5ab86242b363bcbd358936d15e1e2ef45f244b49330aa37ba36918c0dfc12040",
          "providerTrimStart": 0.03,
          "providerTrimEnd": 5.66,
          "extraCues": [
            {
              "id": "separate",
              "phrase": "rebounds"
            },
            {
              "id": "impact1",
              "phrase": "meet"
            }
          ],
          "caption": "Trial 1: separate"
        },
        {
          "id": "tentative",
          "text": "B's dashed arrow is a trial direction. The calculation will decide its signed velocity.",
          "start": 14.05,
          "speechEnd": 19.84,
          "end": 19.84,
          "hold": 0.0,
          "providerAudioSha256": "07b42346a3f5d57efa7d8437f548882a53404f267d71777d7122bc47eba36c06",
          "providerTrimStart": 0.0,
          "providerTrimEnd": 5.79,
          "caption": "Dashed means an assumed direction"
        },
        {
          "id": "reset",
          "text": "Now reset to the original approach. This is a separate trial, with the same initial conditions.",
          "start": 19.99,
          "speechEnd": 26.15,
          "end": 26.15,
          "hold": 0.0,
          "providerAudioSha256": "7dacf762a752ec68083824489f52d7b9f25675e40cd27cecd00e793580454e2c",
          "providerTrimStart": 0.0,
          "providerTrimEnd": 6.16,
          "caption": "Reset: same initial conditions"
        },
        {
          "id": "contact2",
          "text": "This time they meet and stick together, or coalesce. We will find their common velocity.",
          "start": 26.3,
          "speechEnd": 31.97,
          "end": 31.97,
          "hold": 0.0,
          "providerAudioSha256": "dfb3f4eb3c447fa732eac7e65997f2fde3ad3e51b3520239087b87bfb0524a56",
          "providerTrimStart": 0.04,
          "providerTrimEnd": 5.71,
          "extraCues": [
            {
              "id": "stick",
              "phrase": "stick together"
            },
            {
              "id": "impact2",
              "phrase": "meet"
            }
          ],
          "caption": "Trial 2: stick together"
        }
      ],
      "audio": "direct-collisions-s02.mp3",
      "duration": 32.548571,
