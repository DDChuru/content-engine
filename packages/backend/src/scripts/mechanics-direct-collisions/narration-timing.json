    {
      "id": "s01",
      "title": "Syllabus 4.3: direct collisions",
      "mode": "opening",
      "tempo": "brisk",
      "beats": [
        {
          "id": "quote1",
          "text": "Syllabus four point three: use conservation of linear momentum to solve problems",
          "start": 0.55,
          "speechEnd": 6.77,
          "end": 6.77,
          "hold": 0.0,
          "providerAudioSha256": "b6823f261c21e89f62c173b7d2ae33d159a148584a87e79aa9cd997408603049",
          "providerTrimStart": 0.0,
          "providerTrimEnd": 6.22,
          "caption": "use conservation of linear momentum to solve problems"
        },
        {
          "id": "quote2",
          "text": "that may be modelled as the direct impact of two bodies.",
          "start": 6.92,
          "speechEnd": 10.35,
          "end": 10.35,
          "hold": 0.0,
          "providerAudioSha256": "7617cd556e43784cd5d279542f3e65c6fb39ff6693a3d335db6eaff2c6c8c7a6",
          "providerTrimStart": 0.04,
          "providerTrimEnd": 3.47,
          "caption": "that may be modelled as the direct impact of two bodies."
        },
        {
          "id": "outcome1",
          "text": "By the end you can choose signed velocities.",
          "start": 10.5,
          "speechEnd": 13.6,
          "end": 13.6,
          "hold": 0.0,
          "providerAudioSha256": "18d3cda0ae17bc132cda4b498cc838b1bf949207ad1f9354a3f76c4145e9fad7",
          "providerTrimStart": 0.02,
          "providerTrimEnd": 3.12,
          "caption": "Choose signed velocities."
        },
        {
          "id": "outcome2",
          "text": "Conserve the pair's momentum.",
          "start": 13.75,
          "speechEnd": 15.47,
          "end": 15.47,
          "hold": 0.0,
          "providerAudioSha256": "b11da9f452c62e32830feef8588a7593d9431d73c4c73a534f1dd47903adc8ab",
          "providerTrimStart": 0.02,
          "providerTrimEnd": 1.74,
          "caption": "Conserve the pair's momentum."
        },
        {
          "id": "outcome3",
          "text": "And solve separate and sticking outcomes.",
          "start": 15.62,
          "speechEnd": 17.98,
          "end": 17.98,
          "hold": 0.0,
          "providerAudioSha256": "46f411a2f42dc452c1e7dea29f9bb7e912b9e148a8f85720a12be2e404216e22",
          "providerTrimStart": 0.01,
          "providerTrimEnd": 2.37,
          "caption": "Solve separate and sticking outcomes."
        }
      ],
